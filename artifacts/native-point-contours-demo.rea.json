{
  "format": "rea-prototype",
  "version": 1,
  "id": "point-contours-document",
  "name": "Point contour geometry",
  "pages": [
    {
      "id": "point-contours-page",
      "name": "Contour editing",
      "width": 1000,
      "height": 700,
      "background": "#ffffff",
      "widgets": [
        {
          "id": "contours-target",
          "type": "path",
          "name": "Editable compound path",
          "text": "",
          "notes": "",
          "x": 50,
          "y": 100,
          "rotation": 0,
          "width": 250,
          "height": 100,
          "hidden": false,
          "locked": false,
          "disabled": false,
          "style": {
            "fill": "#dbe7ff",
            "stroke": "#234a88",
            "strokeWidth": 1,
            "radius": 0,
            "color": "#263348",
            "fontSize": 14,
            "fontFamily": "Arial",
            "fontWeight": 400,
            "textAlign": "center",
            "opacity": 1
          },
          "interactions": [],
          "vectorPath": {
            "fillRule": "nonzero",
            "commands": [
              {
                "op": "M",
                "x": 0,
                "y": 0
              },
              {
                "op": "L",
                "x": 1,
                "y": 0
              },
              {
                "op": "L",
                "x": 1,
                "y": 1
              },
              {
                "op": "L",
                "x": 0.2,
                "y": 1
              },
              {
                "op": "Z"
              },
              {
                "op": "M",
                "x": 2.6,
                "y": 0
              },
              {
                "op": "L",
                "x": 2.600002,
                "y": 0
              }
            ]
          },
          "shapeText": {
            "autoFitWidth": true,
            "autoFitHeight": true
          }
        }
      ],
      "notes": "",
      "interactions": [],
      "adaptiveSelection": "native-size",
      "adaptiveBaseSize": {
        "width": 0,
        "height": 0
      },
      "adaptiveViews": []
    }
  ],
  "caseSelection": "never",
  "components": [],
  "variables": {},
  "styles": []
}
