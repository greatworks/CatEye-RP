{
  "name": "rea-prototype-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Independent desktop prototype editor; Axure RP 11 parity investigation in progress",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "electron .",
    "package:win": "npm run build && node scripts/package-windows.mjs",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:rp-container": "node --test research/scripts/read-rp-container.test.mjs",
    "test:rp-objects": "node --test research/scripts/read-rp-objects.test.mjs",
    "test:rp-appearance": "node --test research/scripts/read-rp-appearance.test.mjs",
    "test:rp-shapes-forms": "node --test research/scripts/read-rp-shapes-forms.test.mjs",
    "test:rp-images": "node --test research/scripts/read-rp-images.test.mjs",
    "test:rp-interactions": "node --test research/scripts/read-rp-interactions.test.mjs",
    "test:rp-settings": "node --test research/scripts/read-rp-settings.test.mjs",
    "test:rp-fixture": "node --test research/scripts/synthetic-rp-fixture.test.mjs",
    "test:rp-import": "node scripts/smoke-rp-import.mjs",
    "test:rp-image-import": "node scripts/smoke-rp-images.mjs",
    "test:rp-shapes-desktop": "node scripts/smoke-rp-shapes-forms.mjs",
    "test:repeater-desktop": "node scripts/smoke-repeater-pagination.mjs",
    "test:repeater-empty": "node scripts/smoke-repeater-empty.mjs",
    "test:repeater-layout": "node scripts/smoke-repeater-layout.mjs",
    "test:repeater-box": "node scripts/smoke-repeater-box.mjs",
    "test:repeater-row": "node scripts/smoke-repeater-row.mjs",
    "test:rp-vectors": "node --test research/scripts/read-rp-vectors.test.mjs",
    "test:vector-desktop": "node scripts/smoke-vector-editing.mjs",
    "test:rp-page-tree": "node --test research/scripts/read-rp-page-tree.test.mjs",
    "test:page-tree-desktop": "node scripts/smoke-page-tree.mjs",
    "test:interaction-styles-desktop": "node scripts/smoke-interaction-styles.mjs",
    "test:error-hint-desktop": "node scripts/smoke-error-hint.mjs",
    "test:form-properties-desktop": "node scripts/smoke-form-properties.mjs",
    "test:rp-form-properties": "node --test research/scripts/read-rp-form-properties.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
