  "contracts": [
    {
      "id": "NLR-S01",
      "claim": "Initial Base does not refresh all Layer caches. Named view does; named→Base clears moved/resized caches but does not call all-Layer refresh. Original data attributes survive and become fallback. Particular fit/repeater callbacks may still refresh individual Layers.",
      "evidence": "research/native-layers-runtime-initial-bounds-probes.json",
      "source": "adaptive.js 48–159 / 715–752; axQuery.std.js 1471–1517; repeater.js 1881–1930"
    },
    {
      "id": "NLR-S02",
      "claim": "Initial Layer error/selected are applied before disabled. Root then child declaration application starts from empty runtime dictionaries. For two selected/disabled flags the 16-case observed child selected is rootSelected || (!rootDisabled && childSelected); disabled is rootDisabled || childDisabled. Selected events are child then root and are not re-raised by a redundant true declaration.",
      "evidence": "research/native-layers-runtime-initial-state-matrix-probes.json",
      "source": "events.js 805–838; style.js 186–253 and 322–324; axQuery.std.js 1087–1178"
    },
    {
      "id": "NLR-S03",
      "claim": "Visible Layer nesting does not isolate widgetsBelow/Right from enclosing item/state/body. Hidden Layer is a scope barrier. Fully qualifying sibling Layer moves once as Layer, avoiding duplicate leaf motion.",
      "evidence": "research/native-layers-runtime-init-compress-first-probes.json",
      "source": "repeater.js 2362–2480 / 2506 onward",
      "limit": "Controlled geometry/DOM facade; hidden temporary-container interior geometry and full item binding remain unproved."
    },
    {
      "id": "NLR-S04",
      "claim": "Move To action converts root destination into delta before calling moveBy. Member move-info shares this delta. The frozen report direct MoveWidget(to=true) case remains a low-level result and is not the user action contract.",
      "evidence": "research/native-layers-runtime-move-action-probes.json",
      "source": "action.js 756–1042"
    },
    {
      "id": "NLR-S05",
      "claim": "Layer Resize+Rotate evaluates degree once in root Rotate job; evaluates offsetX and offsetY per leaf after calling that leaf Resize. X uses copied event targeted at Layer; Y uses original supplied event. Instant controlled Resize events can alter successive offset results. Root Rotate is emitted twice.",
      "evidence": "research/native-layers-runtime-combined-offset-probes.json",
      "source": "action.js 1286–1506",
      "limit": "Direct consumer, not complete action planner reachability; supplied original target is controlled. Orbit is an argument/completion sink. Nonzero duration is start-only."
    }
