    {
      "name": "missing source does nothing",
      "maps": {
        "new": {
          "x": {
            "value": 2,
            "overridden": true
          }
        }
      },
      "from": "old",
      "to": "new",
      "expected": {
        "new": {
          "x": {
            "value": 2,
            "overridden": true
          }
        }
      },
      "actual": {
        "new": {
          "x": {
            "value": 2,
            "overridden": true
          }
        }
      }
    },
    {
      "name": "same identity does nothing",
      "maps": {
        "old": {
          "x": {
            "value": 1,
            "overridden": true
          }
        }
      },
      "from": "old",
      "to": "old",
      "expected": {
